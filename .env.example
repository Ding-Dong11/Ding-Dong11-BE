# ─────────────────────────────────────────────────────────────
# Ding-Dong11-BE 환경변수 예시
# 실제 값은 .env 로 복사해서 채운다 (.env 는 절대 커밋 금지).
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── 애플리케이션 ──────────────────────────────────────────────
APP_ENV=local                 # local | dev | prod
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── CORS 허용 origin (쉼표 구분, 공백 무시) ──────────────────
# 터널 URL이 바뀔 때마다 여기에 추가/교체 후 서버 재시작
CORS_ORIGINS=http://localhost:5173
# 터널 URL 추가 예시 (쉼표로 구분, 재시작 필요):
# CORS_ORIGINS=http://localhost:5173,https://random-xxx.trycloudflare.com

# ── PostgreSQL / PostGIS ─────────────────────────────────────
POSTGRES_USER=dingdong
POSTGRES_PASSWORD=dingdong
POSTGRES_DB=dingdong
POSTGRES_HOST=localhost        # docker-compose app 컨테이너에서는 db 로 override 됨
POSTGRES_PORT=5432
# SQLAlchemy / Alembic 접속 URL (psycopg v3 드라이버).
# 미지정 시 alembic/env.py 가 위 POSTGRES_* 로 자동 조립한다.
DATABASE_URL=postgresql+psycopg://dingdong:dingdong@localhost:5432/dingdong

# ── Redis (refresh token · 이메일 인증코드 · 지오코딩 캐시) ────
REDIS_HOST=localhost           # docker-compose app 컨테이너에서는 redis 로 override 됨
REDIS_PORT=6379
REDIS_PASSWORD=                # 로컬은 공란, 운영은 설정 권장
REDIS_URL=redis://localhost:6379/0

# ── 인증 / 보안 (JWT) ────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14   # database.md: refresh_token TTL 예시와 일치

# ── 이메일 인증 (SMTP + Redis 코드) ──────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dingdong.example.com
EMAIL_VERIFY_TTL_SECONDS=600       # database.md: 이메일 인증코드 10분
EMAIL_VERIFY_COOLDOWN_SECONDS=180  # database.md: 재발급 쿨다운 3분

# ── Anthropic Claude API (챗봇 FUNC-005 / 추천) ──────────────
ANTHROPIC_API_KEY=              # 절대 하드코딩/커밋 금지
ANTHROPIC_MODEL=claude-opus-4-8 # 필요 시 claude-sonnet-5 / claude-haiku-4-5

# ── 공공데이터 Open API 키 ───────────────────────────────────
# data.go.kr 서비스키 (소상공인 상가정보 API, 식약처 행정처분 API 공용).
# 인코딩/디코딩 키 혼동 방지를 위해 '디코딩(원본)' 키를 넣는다.
DATA_GO_KR_SERVICE_KEY=
# 각 Open API 엔드포인트는 data.go.kr 활용신청 승인 시 발급되는 URL을 그대로 넣는다
# (데이터셋 버전에 따라 경로가 바뀔 수 있어 코드에 하드코딩하지 않고 환경변수로 분리).
DATA_GO_KR_STORES_API_URL=
DATA_GO_KR_DISPOSITIONS_API_URL=
# 국토지리정보원 격자 통계(SGIS 통계지리정보) — API 사용 시. 파일(shp/csv) 적재만 하면 공란 가능.
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# ── 지오코딩 (식약처 행정처분 주소→좌표) ─────────────────────
# 1순위: 카카오 로컬(주소검색) — WGS84(4326) 직접 반환
KAKAO_REST_API_KEY=
# 2순위(fallback): VWorld 지오코더
VWORLD_API_KEY=

# ── ETL 파이프라인 설정 ──────────────────────────────────────
ETL_HTTP_TIMEOUT=30            # 외부 API 요청 타임아웃(초)
ETL_MAX_RETRIES=3             # 429/5xx 지수 백오프 재시도 횟수
ETL_RATE_LIMIT_PER_SEC=5      # 공공 API 초당 호출 상한(토큰버킷)
ETL_CHUNK_SIZE=2000          # 청크 단위 upsert 커밋 건수
ETL_STORES_CSV_PATH=./data/stores  # 소상공인 상가 분기별 CSV(bulk) 경로
GEOCODE_CACHE_TTL_SECONDS=2592000  # 지오코딩 캐시 TTL(30일)
